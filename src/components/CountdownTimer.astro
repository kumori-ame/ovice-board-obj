---
// src/components/CountdownTimer.astro
interface Props {
  targetDate: string; // e.g. "2026-09-13T00:00:00"
  title?: string;
  maxWidth?: string; // e.g. "800px", "100%", "500px"
}

const {
  targetDate,
  title = "文化祭まであと",
  maxWidth = "800px",
} = Astro.props;
---

<div class="timer-wrapper">
  <div class="timer" data-target={targetDate} style={`max-width: ${maxWidth};`}>
    <div class="timer-content">
      <p class="timer-title fs30 mochiy-pop-one-regular">{title}</p>
      <div class="timer-status" aria-live="polite">開催中</div>
      <div class="timer-digits font-bold">
        <div class="time-block">
          <span class="cd_DD fs65 cd-text">--</span>
          <span class="fs30 timer-sub">日</span>
        </div>
        <div class="time-block">
          <span class="cd_HH fs65 cd-text">--</span>
          <span class="fs30 timer-sub">時間</span>
        </div>
        <div class="time-block">
          <span class="cd_MM fs65 cd-text">--</span>
          <span class="fs30 timer-sub">分</span>
        </div>
        <div class="time-block">
          <span class="cd_SS fs65 cd-text">--</span>
          <span class="fs30 timer-sub">秒</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function updateTimers() {
    const timers = document.querySelectorAll(".timer");
    const now = new Date().getTime();

    timers.forEach((timer) => {
      const targetStr = timer.getAttribute("data-target");
      if (!targetStr) return;

      const targetDate = new Date(targetStr).getTime();
      const distance = targetDate - now;

      const ddEl = timer.querySelector(".cd_DD");
      const hhEl = timer.querySelector(".cd_HH");
      const mmEl = timer.querySelector(".cd_MM");
      const ssEl = timer.querySelector(".cd_SS");
      const titleEl = timer.querySelector(".timer-title");
      const statusEl = timer.querySelector(".timer-status");
      const digitsEl = timer.querySelector(".timer-digits");

      const isExpired = distance <= 0;
      timer.classList.toggle("is-celebrating", isExpired);

      if (isExpired) {
        if (titleEl) titleEl.textContent = "";
        if (statusEl) {
          statusEl.innerHTML = `
            <div class="ended-block">
              <p class="ended-title">2026年の文化祭は無事終了しました</p>
              <p class="ended-sub">たくさんのご参加ありがとうございました！</p>
              <p class="ended-note">来年の開催もお楽しみに！</p>
            </div>`;
          statusEl.style.display = "block";
        }
        if (digitsEl) digitsEl.style.display = "none";
        return;
      }

      if (titleEl && titleEl.textContent === "文化祭期間中！") {
        titleEl.textContent = "文化祭まであと";
      }
      if (statusEl) statusEl.style.display = "none";
      if (digitsEl) digitsEl.style.display = "flex";

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor(
        (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
      );
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      if (ddEl) ddEl.textContent = days.toString().padStart(2, "0");
      if (hhEl) hhEl.textContent = hours.toString().padStart(2, "0");
      if (mmEl) mmEl.textContent = minutes.toString().padStart(2, "0");
      if (ssEl) ssEl.textContent = seconds.toString().padStart(2, "0");
    });
  }

  // Update immediately, then every second
  updateTimers();
  setInterval(updateTimers, 1000);
</script>

<style>
  /* CSS adapted from fes-2024 */
  .timer-wrapper {
    display: flex;
    justify-content: center;
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
    margin-bottom: 30px;
    box-sizing: border-box;
    /* Removed overflow: hidden to prevent clipping of skewed corners */
  }

  .timer {
    display: block;
    position: relative;
    padding: 50px 30px;
    transform: skewY(-2.5deg); /* Slightly less aggressive skew */
    background-color: #111;
    color: white;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    width: 90%; /* Responsive width */
    margin: 0 auto;
    transition: all 0.35s ease;
    overflow: hidden;
  }

  .timer::before,
  .timer::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .timer::before {
    background: linear-gradient(
      135deg,
      rgba(255, 200, 57, 0.08),
      rgba(255, 255, 255, 0.02),
      rgba(0, 0, 0, 0.08)
    );
  }

  .timer::after {
    background: rgba(255, 255, 255, 0.02);
  }

  .timer.is-celebrating {
    background: linear-gradient(135deg, #141414 0%, #2d2514 100%);
    box-shadow: 0 14px 42px rgba(0, 0, 0, 0.52), 0 0 18px rgba(255, 207, 87, 0.12);
    border-color: rgba(255, 211, 110, 0.24);
  }

  .timer.is-celebrating::before,
  .timer.is-celebrating::after {
    opacity: 1;
  }

  .timer-content {
    transform: skewY(2.5deg); /* Corresponds to block skew */
    text-align: center;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .timer-title {
    margin-top: 0;
    margin-bottom: 20px;
    font-size: clamp(20px, 4vw, 30px);
    font-family: "Mochiy Pop One", sans-serif;
    color: rgb(75, 255, 114);
    transition: all 0.35s ease;
  }

  .timer.is-celebrating .timer-title {
    color: rgb(75, 255, 114);
  }

  .timer-status {
    display: none;
    margin: 0 auto 18px;
    font-family: "Mochiy Pop One", sans-serif;
    font-size: clamp(45px, 5vw, 42px);
    letter-spacing: 0.01em;
    color: #fffdf7;
    text-shadow: 0 0 16px rgba(255, 255, 255, 0.8), 0 0 28px rgba(255, 204, 86, 0.38);
  }

  /* Ended message block */
  .ended-block {
    display: inline-block;
    text-align: center;
    padding: 14px 22px;
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 6px 24px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.02);
    max-width: min(860px, 90%);
  }

  .ended-title {
    margin: 0;
    font-size: clamp(18px, 3.4vw, 26px);
    color: #ffd77a;
    font-weight: 900;
    letter-spacing: 0.01em;
  }

  .ended-sub {
    margin: 0;
    font-size: clamp(18px, 3.2vw, 20px);
    color: #ffffff;
    opacity: 0.95;
  }

  .ended-note {
    margin: 0;
    font-size: clamp(32px, 4.5vw, 20px);
    color: #dfe7d9;
    opacity: 0.9;
  }

  .timer-digits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(5px, 1vw, 20px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .timer.is-celebrating .timer-digits {
    opacity: 0.12;
    transform: scale(0.96);
  }

  .time-block {
    display: flex;
    align-items: baseline;
    justify-content: center;
  }

  .cd-text {
    font-family: "JetBrains Mono", sans-serif;
    font-size: clamp(32px, 6vw, 55px);
    line-height: 1;
    font-variant-numeric: tabular-nums; /* Force digits to be fixed-width */
    display: inline-block;
    min-width: 1.2em; /* Ensure '1' and '8' take same container space */
    text-align: center;
  }

  .timer-sub {
    font-size: clamp(16px, 3vw, 30px);
    margin-left: 5px;
    margin-right: 5px;
  }

</style>
